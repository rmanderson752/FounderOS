# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (v3 agent loop — phase 2)
ANTHROPIC_API_KEY=

# Google Calendar (read-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# v2 flow only (/api/google/callback). Not read by the v3 daily path.
GOOGLE_REDIRECT_URI=
# v3 calendar flow. Optional — defaults to <origin>/api/calendar/callback.
# Set only to pin an exact URI in production.
GOOGLE_CALENDAR_REDIRECT_URI=

# 32 bytes, base64 or hex. Encrypts calendar OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
