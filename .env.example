# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (v3 agent loop — phase 2)
ANTHROPIC_API_KEY=

# Google Calendar (read-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <origin>/api/calendar/callback.
# Set this in production to pin the exact URI registered in the Google console.
GOOGLE_REDIRECT_URI=

# 32 bytes, base64 or hex. Encrypts calendar OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
