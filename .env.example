# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (v3 agent loop — phase 2)
ANTHROPIC_API_KEY=

# Google Calendar (read-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# v2 flow only (/api/google/callback). Not read by the v3 daily path.
GOOGLE_REDIRECT_URI=
# v3 calendar flow. Optional — defaults to <origin>/api/calendar/callback.
# If only the v2 URI (/api/google/callback) is registered on the OAuth client,
# point this at it: the v3 flow completes there too.
GOOGLE_CALENDAR_REDIRECT_URI=

# 32 bytes, base64 or hex. Encrypts calendar OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- v4 Start Card ---
# Shared secret Vercel Cron sends to /api/jobs/daily. Generate with: openssl rand -hex 24
CRON_SECRET=
# Optional. Resend API key and recipient for the morning card email. Empty = no email.
RESEND_API_KEY=
CARD_EMAIL_TO=
CARD_EMAIL_FROM=Founder OS <onboarding@resend.dev>
# Public origin, used in the card's Start line and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
